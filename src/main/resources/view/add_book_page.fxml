                  <Label layoutX="228.0" layoutY="11.0" text="Add New Book">
                     <font>
                        <Font name="Arial Black" size="18.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
         </children>
      </HBox>
      <HBox layoutY="50.0" prefHeight="348.0" prefWidth="600.0">
         <children>
            <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="445.0" prefWidth="600.0" style="-fx-background-color: #CAF0F8;">
               <children>
                  <Label layoutX="68.0" layoutY="44.0" text="Book ID/ISBN:" textAlignment="CENTER">
                     <font>
                        <Font name="Arial Black" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtId" layoutX="218.0" layoutY="42.0" prefHeight="26.0" prefWidth="284.0" />
                  <Label layoutX="68.0" layoutY="100.0" text="Book Title:" textAlignment="CENTER">
                     <font>
                        <Font name="Arial Black" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtTitle" layoutX="218.0" layoutY="98.0" prefHeight="26.0" prefWidth="284.0" />
                  <Label layoutX="68.0" layoutY="150.0" text="Author:" textAlignment="CENTER">
                     <font>
                        <Font name="Arial Black" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtAuthor" layoutX="218.0" layoutY="148.0" prefHeight="26.0" prefWidth="284.0" />
                  <Label layoutX="64.0" layoutY="202.0" text="Category:" textAlignment="CENTER">
                     <font>
                        <Font name="Arial Black" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtCategory" layoutX="218.0" layoutY="200.0" prefHeight="26.0" prefWidth="284.0" />
                  <Label layoutX="64.0" layoutY="258.0" text="Published Year:" textAlignment="CENTER">
