                     <font>
                        <Font name="Arial Narrow Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnClear" layoutX="382.0" layoutY="377.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: Blue;" text="Clear" textFill="WHITE">
